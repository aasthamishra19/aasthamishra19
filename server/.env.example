PORT=5000

# Local dev without MongoDB installed (data is lost when the server stops):
# MONGODB_URI=memory

# Local MongoDB or Atlas (required for production — see DEPLOY.md):
MONGODB_URI=mongodb://127.0.0.1:27017/flowtrack

JWT_SECRET=change-this-to-a-long-random-string-in-production

# Browser origin(s) allowed by CORS. Production: your Vercel URL, e.g. https://myapp.vercel.app
# Multiple: comma-separated, no spaces after comma optional
CLIENT_URL=http://localhost:5173
